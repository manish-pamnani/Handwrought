# Google Analytics 4 measurement ID (public — safe to expose to the browser).
# Get it from: GA Admin > Data Streams > your web stream > Measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Firebase client SDK config (public — safe to expose to the browser).
# Get these from: Firebase console > Project settings > General > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local-dev-only fallback Gemini key, used by app/api/chat/route.ts when no
# user-supplied (BYOK) key and no GEMINI_SHARED_API_KEY are present. Never
# used in production (NODE_ENV is checked).
GEMINI_API_KEY=

# Production shared Gemini key — powers free guest generations (see
# FREE_GENERATIONS_LIMIT in lib/constants.ts) and lifetime-access users who
# haven't added their own key. Server-side only, never exposed to the browser.
GEMINI_SHARED_API_KEY=

# Deepgram API key (server-side only) — used by app/api/dictate/token/route.ts
# to generate short-lived ephemeral tokens for live streaming dictation (Nova-3).
DEEPGRAM_API_KEY=

# Paddle checkout (Paddle.js). Client token is safe to expose to the browser.
# Get it from Paddle > Developer tools > Authentication (sandbox or live).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Go-live switch for the Paddle checkout UI, separate from the vars above —
# checkout always falls back to the waitlist form unless this is exactly
# "true". Leave unset until Paddle's domain verification is approved; flip to
# "true" in Vercel (alongside the live values above and the live price IDs in
# lib/constants.ts) when ready to accept real payments.
NEXT_PUBLIC_PADDLE_CHECKOUT_ENABLED=

# Server-side only — never exposed to the browser. Used by seed scripts and
# the transaction.completed webhook handler.
PADDLE_API_KEY=

# Secret for the "transaction.completed" notification destination, from
# Paddle > Developer tools > Notifications > [destination] > Secret key.
PADDLE_NOTIFICATION_WEBHOOK_SECRET=

# Firebase Admin (server-side only). From Firebase Console > Project settings
# > Service accounts > Generate new private key. FIREBASE_PRIVATE_KEY keeps
# its \n newlines escaped as literal "\n" in this file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Resend (transactional email — currently just the waitlist confirmation).
# Get it from Resend > API Keys. Sending "from" waitlist@handwrought.online
# requires verifying that domain under Resend > Domains first (DNS records
# added at the registrar), or sends will fail/bounce.
RESEND_API_KEY=
