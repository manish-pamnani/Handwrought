# Firebase client SDK config (public — safe to expose to the browser).
# Get these from: Firebase console > Project settings > General > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local-dev-only fallback Gemini key, used by app/api/chat/route.ts when no
# user-supplied (BYOK) key is present. Never used in production (NODE_ENV
# is checked), so this never becomes a shared free key for real users.
GEMINI_API_KEY=

# Paddle checkout (Paddle.js). Client token is safe to expose to the browser.
# Get it from Paddle > Developer tools > Authentication (sandbox or live).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Server-side only — never exposed to the browser. Used by seed scripts and
# the transaction.completed webhook handler.
PADDLE_API_KEY=

# Secret for the "transaction.completed" notification destination, from
# Paddle > Developer tools > Notifications > [destination] > Secret key.
PADDLE_NOTIFICATION_WEBHOOK_SECRET=

# Firebase Admin (server-side only). From Firebase Console > Project settings
# > Service accounts > Generate new private key. FIREBASE_PRIVATE_KEY keeps
# its \n newlines escaped as literal "\n" in this file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
